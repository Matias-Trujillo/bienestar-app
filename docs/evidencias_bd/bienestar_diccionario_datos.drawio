e=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;&lt;b&gt;&lt;u&gt;id&lt;/u&gt;&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;INTEGER&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;&lt;b style=&quot;color:#0c2b45;&quot;&gt;PK&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Identificador único autoincremental del proceso de nómina masiva.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;tipo_bono&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(60)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Código del beneficio masivo procesado (&amp;#x27;invierno&amp;#x27;, &amp;#x27;navidad&amp;#x27; o &amp;#x27;vacaciones_masivo&amp;#x27;).&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;titulo&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(150)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Título oficial de la planilla de liquidación masiva generada para Tesorería.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;periodo&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(60)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Período o mes calendario al que corresponde la liquidación (ej. &amp;#x27;Julio 2026&amp;#x27;, &amp;#x27;Diciembre 2026&amp;#x27;).&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;porcentaje&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;FLOAT (FLOAT8)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Porcentaje sobre el Grado 15 aplicado a la nómina (15% Invierno; 10% a 15% Navidad).&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;sueldo_base_utilizado&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;INTEGER&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Snapshot en CLP del Sueldo Base Grado 15 vigente al momento de ejecutar la nómina.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;monto_unitario&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;INTEGER&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Monto individual en CLP calculado para cada socio habilitado dentro de la nómina.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;total_socios_evaluados&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;INTEGER&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Cantidad total de socios activos del padrón analizados por el motor de nómina.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;total_socios_beneficiados&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;INTEGER&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Cantidad de socios que cumplieron los 6 meses de carencia y recibieron el beneficio.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;total_socios_excluidos&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;INTEGER&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Cantidad de socios excluidos automáticamente por encontrarse aún en período de carencia (&amp;lt; 6 meses).&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;monto_total_liquidado&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;INTEGER&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Desembolso financiero total en CLP requerido por la nómina (beneficiados × monto unitario).&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;estado&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(40)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Estado administrativo de la nómina masiva (ej. &amp;#x27;APROBADA_TESORERIA&amp;#x27;).&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;decreto_marco&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(100)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;Sí&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Número del Decreto Alcaldicio marco que autoriza el pago colectivo del beneficio.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;acuerdo_directorio_acta&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(100)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;Sí&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Referencia al Acta del Directorio de Bienestar donde se aprobó el porcentaje y presupuesto.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;&lt;b&gt;creado_por_id&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;INTEGER&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;&lt;b style=&quot;color:#006799;&quot;&gt;FK (usuarios.id)&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Clave foránea hacia el directivo o administrador en &amp;#x27;usuarios&amp;#x27; que generó y cerró la nómina.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;