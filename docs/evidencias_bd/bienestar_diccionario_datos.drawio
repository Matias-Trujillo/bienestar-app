nt-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;antiguedad_meses&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;INTEGER&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Snapshot con la cantidad exacta de meses de permanencia evaluada por la regla de carencia.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;cumple_antiguedad&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;BOOLEAN&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Indica si el socio superó el filtro de 6 meses de carencia mínima (true = habilitado; false = excluido).&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;motivo_exclusion&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(255)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;Sí&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Causal registrada automáticamente cuando el socio queda excluido del pago (ej. carencia vigente).&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;monto&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;INTEGER&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Monto individual en CLP asignado al socio en la nómina ($0 si fue excluido por carencia).&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;decreto_asociado&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(100)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;Sí&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Número de decreto individual o marco asociado al pago de ese funcionario.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;decreto_digital_url&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(500)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;Sí&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Ruta del archivo PDF del decreto digitalizado vinculado al registro de pago.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;metodo_pago&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(40)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Modalidad de pago instruida a Tesorería para el socio (por defecto &amp;#x27;Cheque&amp;#x27;).&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;numero_cheque&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(60)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;Sí&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Folio correlativo del cheque asignado individualmente al socio beneficiado.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;banco&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(100)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;Sí&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Institución bancaria contra la cual se gira el cheque del beneficio.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;estado_pago&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(30)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Estado de emisión del pago individual (&amp;#x27;EMITIDO&amp;#x27; para habilitados o &amp;#x27;EXCLUIDO&amp;#x27;).&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;created_at&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;TIMESTAMPTZ&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Fecha y hora exacta de creación del registro en la tabla &amp;#x27;detalles_nomina_masiva&amp;#x27; (trazabilidad temporal).&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;updated_at&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;TIMESTAMPTZ&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Fecha y hora de la última actualización experimentada por el registro en &amp;#x27;detalles_nomina_masiva&amp;#x27;.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;strokeColor=none;fillColor=none;overflow=fill;align=left;verticalAlign=top;spacing=0;" parent="1" vertex="1"><mxGeometry x="80" y="40" width="1280" height="629" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="tab_10_audit_logs" name="10. audit_logs"><mxGraphModel dx="1500" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="900" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="single_tbl_10_audit_logs" value="&lt;table style=&quot;width:100%; border-collapse:collapse; font-family:Helvetica,Arial,sans-serif; background-color:#ffffff; border:2px solid #0c2b45;&quot;&gt;&lt;tr style=&quot;background-color:#0c2b45; color:#ffffff;&quot;&gt;&lt;td colspan=&quot;5&quot; style=&quot;padding:10px 14px; font-size:13px; font-weight:bold; border:1px solid #0c2b45; text-align:left;&quot;&gt;TABLA 10: audit_logs (12 atributos) &amp;mdash; &lt;span style=&quot;font-weight:normal; color:#e2e8f0;&quot;&gt;Bitácora forense inmutable (Append-Only) de eventos críticos para fiscalización y Contraloría General de la República (HU-10).&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#006799; color:#ffffff; font-weight:bold; font-size:11.5px;&quot;&gt;&lt;td style=&quot;width:18%; padding:7px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Atributo&lt;/td&gt;&lt;td style=&quot;width:15%; padding:7px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Tipo de Dato&lt;/td&gt;&lt;td style=&quot;width:16%; padding:7px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;PK / FK&lt;/td&gt;&lt;td style=&quot;width:7%; padding:7px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;Nulo&lt;/td&gt;&lt;td style=&quot;width:44%; padding:7px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Descripci&amp;oacute;n&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;&lt;b&gt;&lt;u&gt;id&lt;/u&gt;&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;INTEGER&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;&lt;b style=&quot;color:#0c2b45;&quot;&gt;PK&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Identificador único secuencial del evento en la bitácora forense.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;created_at&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;TIMESTAMPTZ&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Estampa de tiempo exacta e inalterable (TIMESTAMPTZ) en que ocurrió la acción auditada.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;&lt;b&gt;usuario_id&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;INTEGER&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;&lt;b style=&quot;color:#006799;&quot;&gt;FK (usuarios.id)&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;Sí&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Clave foránea hacia el actor en &amp;#x27;usuarios&amp;#x27; que ejecutó la operación (NULL si es postulante externo).&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;usuario_nombre&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(150)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Snapshot forense inmutable con el nombre completo de quien ejecutó la acción.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;usuario_rut&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(20)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;Sí&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Snapshot forense inmutable con el RUN del actor al momento del evento.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;usuario_rol&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(50)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Snapshot forense con el rol con que operaba el usuario al ejecutar la acción.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;modulo&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(50)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Módulo funcional donde se originó el evento (AFILIACION, REEMBOLSOS, BENEFICIOS, SEGURIDAD, etc.).&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;accion&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(100)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Código tipificado de la operación crítica realizada (ej. APROBAR_SOLICITUD_DIRECTORIO, LIQUIDAR_BONO).&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;recurso_tipo&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(50)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Nombre de la entidad de dominio afectada por la operación (User, SolicitudReembolso, etc.).&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;recurso_id&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(100)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;Sí&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Folio o identificador primario del registro específico afectado por la transacción.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;detalles&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;TEXT&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;Sí&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Evidencia descriptiva completa de los valores modificados, montos o acuerdos asociados.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;ip_origen&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(60)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;Sí&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Dirección IP o identificador de origen desde donde se solicitó la transacción.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;strokeColor=none;fillColor=none;overflow=fill;align=left;verticalAlign=top;spacing=0;" parent="1" vertex="1"><mxGeometry x="80" y="40" width="1280" height="426" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="tab_11_parametros_sistema" name="11. parametros_sistema"><mxGraphModel dx="1500" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="900" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="single_tbl_11_parametros_sistema" value="&lt;table style=&quot;width:100%; border-collapse:collapse; font-family:Helvetica,Arial,sans-serif; background-color:#ffffff; border:2px solid #0c2b45;&quot;&gt;&lt;tr style=&quot;background-color:#0c2b45; color:#ffffff;&quot;&gt;&lt;td colspan=&quot;5&quot; style=&quot;padding:10px 14px; font-size:13px; font-weight:bold; border:1px solid #0c2b45; text-align:left;&quot;&gt;TABLA 11: parametros_sistema (6 atributos) &amp;mdash; &lt;span style=&quot;font-weight:normal; color:#e2e8f0;&quot;&gt;Tabla de configuración global institucional (Sueldo Base Grado 15, porcentajes reglamentarios y servidor SMTP).&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#006799; color:#ffffff; font-weight:bold; font-size:11.5px;&quot;&gt;&lt;td style=&quot;width:18%; padding:7px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Atributo&lt;/td&gt;&lt;td style=&quot;width:15%; padding:7px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Tipo de Dato&lt;/td&gt;&lt;td style=&quot;width:16%; padding:7px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;PK / FK&lt;/td&gt;&lt;td style=&quot;width:7%; padding:7px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;Nulo&lt;/td&gt;&lt;td style=&quot;width:44%; padding:7px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Descripci&amp;oacute;n&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;&lt;b&gt;&lt;u&gt;id&lt;/u&gt;&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;INTEGER&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;&lt;b style=&quot;color:#0c2b45;&quot;&gt;PK&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Identificador único autoincremental del parámetro de configuración.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;clave&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(60)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Nombre único de la constante institucional (ej. SUELDO_BASE_GRADO_15, BONO_NAVIDAD_PORCENTAJE).&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;valor&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(255)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Valor vigente del parámetro (ej. &amp;#x27;750000&amp;#x27; para el Sueldo Base Grado 15 en CLP).&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;descripcion&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(255)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Explicación normativa de la finalidad del parámetro dentro del Reglamento de Bienestar.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;created_at&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;TIMESTAMPTZ&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Fecha y hora exacta de creación del registro en la tabla &amp;#x27;parametros_sistema&amp;#x27; (trazabilidad temporal).&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;updated_at&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;TIMESTAMPTZ&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Fecha y hora de la última actualización experimentada por el registro en &amp;#x27;parametros_sistema&amp;#x27;.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;strokeColor=none;fillColor=none;overflow=fill;align=left;verticalAlign=top;spacing=0;" parent="1" vertex="1"><mxGeometry x="80" y="40" width="1280" height="252" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>