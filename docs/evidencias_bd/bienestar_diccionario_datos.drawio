<mxfile host="app.diagrams.net" modified="2026-11-15T17:35:00.000Z" agent="Antigravity Peralillo Engine" version="21.0.0" type="device"><diagram id="diccionario_vista_general" name="Vista General (11 Tablas)"><mxGraphModel dx="1500" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="7416" background="#f8fafc"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="banner_diccionario" value="COMITE DE BIENESTAR - ILUSTRE MUNICIPALIDAD DE PERALILLO&amp;#xa;DICCIONARIO DE DATOS OFICIAL EN POSTGRESQL 15 (11 TABLAS, 201 ATRIBUTOS, 18 CLAVES FORANEAS)" style="text;html=1;strokeColor=#0c2b45;fillColor=#0c2b45;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontColor=#ffffff;fontStyle=1;fontSize=15;" parent="1" vertex="1"><mxGeometry x="80" y="20" width="1280" height="55" as="geometry" /></mxCell><mxCell id="dict_tbl_1_usuarios" value="&lt;table style=&quot;width:100%; border-collapse:collapse; font-family:Helvetica,Arial,sans-serif; background-color:#ffffff; border:2px solid #0c2b45;&quot;&gt;&lt;tr style=&quot;background-color:#0c2b45; color:#ffffff;&quot;&gt;&lt;td colspan=&quot;5&quot; style=&quot;padding:10px 14px; font-size:13px; font-weight:bold; border:1px solid #0c2b45; text-align:left;&quot;&gt;TABLA 1: usuarios (21 atributos) &amp;mdash; &lt;span style=&quot;font-weight:normal; color:#e2e8f0;&quot;&gt;Entidad maestra de funcionarios municipales afiliados y cuentas con roles directivos/administrativos (HU-01, HU-09).&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#006799; color:#ffffff; font-weight:bold; font-size:11.5px;&quot;&gt;&lt;td style=&quot;width:18%; padding:7px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Atributo&lt;/td&gt;&lt;td style=&quot;width:15%; padding:7px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Tipo de Dato&lt;/td&gt;&lt;td style=&quot;width:16%; padding:7px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;PK / FK&lt;/td&gt;&lt;td style=&quot;width:7%; padding:7px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;Nulo&lt;/td&gt;&lt;td style=&quot;width:44%; padding:7px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Descripci&amp;oacute;n&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;&lt;b&gt;&lt;u&gt;id&lt;/u&gt;&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;INTEGER&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;&lt;b style=&quot;color:#0c2b45;&quot;&gt;PK&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Identificador único autoincremental del funcionario o usuario en el sistema.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;rut&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(15)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Rol Único Tributario (RUN) chileno normalizado con validación de Módulo 11 (identificador único de acceso).&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;email&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(120)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Correo electrónico institucional (@mperalillo.cl) o personal registrado para notificaciones y acceso.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;nombre_completo&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(120)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Nombres y apellidos completos del funcionario municipal afiliado o directivo.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;hashed_password&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(255)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Hash criptográfico de la contraseña encriptada mediante algoritmo Bcrypt (costo 12).&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;rol&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;ENUM (user_role)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Rol de control de acceso basado en privilegios (superusuario, presidente, secretario, tesorero, admin, auditor, socio).&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;is_superuser&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;BOOLEAN&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Indicador booleano que otorga privilegios totales de Superadministrador sobre el sistema.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;is_active&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;BOOLEAN&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Estado operativo de la cuenta (true = socio activo habilitado; false = socio suspendido o dado de baja).&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;departamento&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(120)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Dirección o unidad municipal a la que pertenece el funcionario (ej. DIDECO, Obras, Secretaría Municipal).&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;antiguedad&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(60)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Glosa descriptiva del tiempo de permanencia en el Comité de Bienestar (ej. &amp;#x27;1 Año, 4 Meses&amp;#x27;).&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;estado_previsional&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(20)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Estado de cumplimiento en las cotizaciones y retenciones mensuales del socio (ej. &amp;#x27;Al día&amp;#x27;).&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;saldo_salud_disponible&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;INTEGER&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Cupo monetario remanente en pesos chilenos (CLP) para reembolsos médicos en el año calendario vigente.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;saldo_salud_total_anual&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;INTEGER&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Tope anual máximo de cobertura médica en CLP asignado al socio por año calendario ($150.000 CLP).&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;cargas_registradas&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;INTEGER&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Cantidad total de cargas familiares vigentes y aprobadas asociadas al socio titular.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;meses_antiguedad&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;INTEGER&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Cantidad entera de meses continuos de afiliación para validar la regla de carencia mínima de 6 meses.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;created_at&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;TIMESTAMPTZ&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Fecha y hora exacta de creación del registro en la tabla &amp;#x27;usuarios&amp;#x27; (trazabilidad temporal).&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;updated_at&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;TIMESTAMPTZ&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Fecha y hora de la última actualización experimentada por el registro en &amp;#x27;usuarios&amp;#x27;.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;intentos_fallidos&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;INTEGER&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Contador de intentos fallidos consecutivos de inicio de sesión (bloqueo preventivo al 5° intento).&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;password_bloqueada&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;BOOLEAN&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Indica si la cuenta se encuentra bloqueada por seguridad tras superar el máximo de intentos fallidos.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;debe_cambiar_password&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;BOOLEAN&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Exige al usuario actualizar su clave temporal de un solo uso en su próximo inicio de sesión.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;ultimo_cambio_password&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;TIMESTAMPTZ&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;Sí&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Fecha y hora exacta de la última actualización de contraseña realizada por el funcionario.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;strokeColor=none;fillColor=none;overflow=fill;align=left;verticalAlign=top;spacing=0;" parent="1" vertex="1"><mxGeometry x="80" y="100" width="1280" height="687" as="geometry" /></mxCell><mxCell id="dict_tbl_2_solicitudes_afiliacion" value="&lt;table style=&quot;width:100%; border-collapse:collapse; font-family:Helvetica,Arial,sans-serif; background-color:#ffffff; border:2px solid #0c2b45;&quot;&gt;&lt;tr style=&quot;background-color:#0c2b45; color:#ffffff;&quot;&gt;&lt;td colspan=&quot;5&quot; style=&quot;padding:10px 14px; font-size:13px; font-weight:bold; border:1px solid #0c2b45; text-align:left;&quot;&gt;TABLA 2: solicitudes_afiliacion (21 atributos) &amp;mdash; &lt;span style=&quot;font-weight:normal; color:#e2e8f0;&quot;&gt;Registro de postulaciones digitales de incorporación al Comité, autorización del 4% y resolución por Acta (HU-01, HU-02).&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#006799; color:#ffffff; font-weight:bold; font-size:11.5px;&quot;&gt;&lt;td style=&quot;width:18%; pa