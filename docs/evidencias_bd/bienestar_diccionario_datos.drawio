td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Código correlativo anual único del expediente de afiliación (formato AF-AAAA-NNNNN).&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;nombre_completo&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(120)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Nombre completo del funcionario municipal que postula a incorporarse al Comité.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;run&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(12)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;RUN chileno del funcionario postulante validado con dígito verificador Módulo 11.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;grado&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(10)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Grado en el escalafón de la planta o contrata municipal del postulante (ej. Grado 10 a 15).&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;calidad_contractual&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;ENUM (calidad_contractual)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Calidad jurídica del vínculo laboral con el municipio (&amp;#x27;Planta&amp;#x27; o &amp;#x27;Contrata&amp;#x27;).&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;email&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(120)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;Sí&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Correo electrónico declarado por el postulante para recibir el comprobante y la resolución.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;autoriza_descuento&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;BOOLEAN&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Consentimiento expreso y obligatorio para el descuento mensual por planilla del 4% del sueldo base.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;porcentaje_descuento&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;INTEGER&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Porcentaje estatutario de retención mensual sobre el sueldo base autorizado por el socio (4%).&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;acepta_carencia&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;BOOLEAN&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Declaración jurada de aceptación de la cláusula de 6 meses de carencia inicial para impetrar beneficios.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;estado&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;ENUM (estado_solicitud)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Estado de tramitación de la postulación (&amp;#x27;Pendiente de aprobación&amp;#x27;, &amp;#x27;Aprobada&amp;#x27; o &amp;#x27;Rechazada&amp;#x27;).&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;fecha_sesion&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;DATE&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;Sí&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Fecha de la sesión ordinaria del