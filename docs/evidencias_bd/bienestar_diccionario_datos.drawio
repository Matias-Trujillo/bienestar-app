 #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;Sí&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Snapshot del correo electrónico del socio titular para despacho de notificaciones de resolución.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;nombre_completo&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(120)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Nombres y apellidos completos del familiar que se solicita inscribir como carga vigente.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;run&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(15)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;RUN chileno de la carga familiar sujeto a verificación de unicidad y Módulo 11.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;parentesco&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(40)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Relación de parentesco legal respecto del funcionario titular (Hijo/a, Cónyuge, etc.).&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;observacion_socio&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(300)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;Sí&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Nota o antecedente adicional ingresado por el socio o por la secretaría al registrar la carga.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;certificado_nombre&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(255)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;Sí&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Nombre del archivo digital de respaldo (certificado de nacimiento, matrimonio o cédula).&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;certificado_tipo&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(120)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;Sí&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Tipo de certificado legal exigido según el parentesco declarado.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;certificado_data&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;TEXT&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;Sí&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Respaldo digital adjunto para verificación visual por parte de la Directiva.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;estado&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;ENUM (estado_solicitud)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Estado de resolución de la carga (&amp;#x27;Pendiente de aprobación&amp;#x27;, &amp;#x27;Aprobada&amp;#x27; o &amp;#x27;Rechazada&amp;#x27;).&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;fecha_sesion&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;DATE&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;Sí&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Fecha de la sesión de Directorio en que se aprobó o rechazó la inscripción de la carga.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;numero_acta&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(50)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;Sí&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Número de Acta de Directorio donde consta la incorporación oficial de la carga.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;observaciones_resolucion&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(500)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;Sí&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Observaciones de aprobación o motivo fundado de rechazo para subsanación.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;resuelto_por&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(120)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;Sí&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Snapshot histórico con el nombre y cargo del evaluador al momento de resolver.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;resuelto_at&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;TIMESTAMPTZ&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;Sí&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Fecha y hora exacta en que la Directiva emitió la resolución sobre la carga familiar.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;created_at&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;TIMESTAMPTZ&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Fecha y hora exacta de creación del registro en la tabla &amp;#x27;solicitudes_cargas_familiares&amp;#x27; (trazabilidad temporal).&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;updated_at&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;TIMESTAMPTZ&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Fecha y hora de la última actualización experimentada por el registro en &amp;#x27;solicitudes_cargas_familiares&amp;#x27;.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;&lt;b&gt;carga_id&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;INTEGER&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;&lt;b style=&quot;color:#006799;&quot;&gt;FK (cargas_familiares.id)&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;Sí&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Clave foránea opcional hacia &amp;#x27;cargas_familiares&amp;#x27; cuando la solicitud deriva de la incorporación inicial.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;&lt;b&gt;resuelto_por_id&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;INTEGER&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;&lt;b style=&quot;color:#006799;&quot;&gt;FK (usuarios.id)&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;Sí&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Clave foránea hacia el directivo o administrador en &amp;#x27;usuarios&amp;#x27; que evaluó la solicitud.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;strokeColor=none;fillColor=none;overflow=fill;align=left;verticalAlign=top;spacing=0;" parent="1" vertex="1"><mxGeometry x="80" y="2006" width="1280" height="745" as="geometry" /></mxCell><mxCell id="dict_tbl_5_solicitudes_reembolso" value="&lt;table style=&quot;width:100%; border-collapse:collapse; font-family:Helvetica,Arial,sans-serif; background-color:#ffffff; border:2px solid #0c2b45;&quot;&gt;&lt;tr style=&quot;background-color:#0c2b45; color:#ffffff;&quot;&gt;&lt;td colspan=&quot;5&quot; style=&quot;padding:10px 14px; font-size:13px; font-weight:bold; border:1px solid #0c2b45; text-align:left;&quot;&gt;TABLA 5: solicitudes_reembolso (23 atributos) &amp;mdash; &lt;span style=&quot;font-weight:normal; color:#e2e8f0;&quot;&gt;Solicitudes de reembolso por prestaciones médicas, dentales y farmacéuticas con control de tope anual y plazo de 30 días (HU-03, HU-04).&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#006799; color:#ffffff; font-weight:bold; font-size:11.5px;&quot;&gt;&lt;td style=&quot;width:18%; padding:7px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Atributo&lt;/td&gt;&lt;td style=&quot;width:15%; padding:7px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Tipo de Dato&lt;/td&gt;&lt;td style=&quot;width:16%; padding:7px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;PK / FK&lt;/td&gt;&lt;td style=&quot;width:7%; padding:7px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;Nulo&lt;/td&gt;&lt;td style=&quot;width:44%; padding:7px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Descripci&amp;oacute;n&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;&lt;b&gt;&lt;u&gt;id&lt;/u&gt;&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;INTEGER&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;&lt;b style=&quot;color:#0c2b45;&quot;&gt;PK&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Identificador único autoincremental de la solicitud de reembolso médico.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;codigo&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(20)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Código correlativo institucional de la solicitud de reembolso (formato RMB-NNNN).&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;&lt;b&gt;socio_id&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;INTEGER&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;&lt;b style=&quot;color:#006799;&quot;&gt;FK (usuarios.id)&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Clave foránea hacia el socio titular en &amp;#x27;usuarios&amp;#x27; a cuyo cupo anual se imputa el gasto.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;tipo_prestacion&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;ENUM (tipo_prestacion)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Categoría médica del gasto (farmacia, consulta, dental, examenes, optica, hospitalizacion, otros).&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;descripcion&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;TEXT&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Detalle descriptivo de la prestación médica, medicamentos o atención recibida.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;beneficiario_nombre&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(120)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Nombre completo del paciente atendido (puede ser el socio titular o una carga aprobada).&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;beneficiario_parentesco&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(30)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Calidad del paciente respecto del socio (&amp;#x27;Titular&amp;#x27; o el parentesco de la carga familiar).&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;monto_boleta&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;INTEGER&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Monto total facturado en la boleta o bono médico expresado en pesos chilenos enteros (CLP).&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;monto_copago&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;INTEGER&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Monto efectivo de bolsillo (copago no cubierto por Fonasa/Isapre) solicitado a reembolsar en CLP.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;monto_reembolso&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;INTEGER&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Monto final en CLP imputado al cupo anual del socio (retenido preventivamente al postular).&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;fecha_atencion&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;DATE&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Fecha en que se efectuó la prestación médica (sujeta al plazo máximo de 30 días corridos).&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;fecha_boleta&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;DATE&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Fecha de emisión del documento tributario, boleta de farmacia o bono de atención.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;tipo_documento&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(40)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Clase de respaldo adjunto (receta_medica, boleta_detallada, bono_copago, comprobante_isapre_fonasa).&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;comprobante_filename&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(255)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Nombre original del archivo PDF o imagen del comprobante subido por el socio.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;comprobante_url&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(500)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Ruta interna del endpoint seguro para visualizar o descargar el comprobante médico.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;declaracion_aceptada&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;BOOLEAN&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Aceptación obligatoria de la declaración jurada sobre la veracidad y legalidad del gasto.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;estado&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;ENUM (estado_reembolso)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Estado del flujo del reembolso (&amp;#x27;borrador&amp;#x27;, &amp;#x27;en_revision&amp;#x27;, &amp;#x27;aprobado&amp;#x27;, &amp;#x27;rechazado&amp;#x27;, &amp;#x27;pagado&amp;#x27;).&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;motivo_rechazo&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;TEXT&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Justificación obligatoria registrada por la administración cuando se rechaza y restituye el saldo.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;created_at&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;TIMESTAMPTZ&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Fecha y hora exacta de creación del registro en la tabla &amp;#x27;solicitudes_reembolso&amp;#x27; (trazabilidad temporal).&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;updated_at&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;TIMESTAMPTZ&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Fecha y hora de la última actualización experimentada por el registro en &amp;#x27;solicitudes_reembolso&amp;#x27;.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;beneficiario_run&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(20)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;Sí&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;RUN chileno del paciente beneficiario de la prestación de salud.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;&lt;b&gt;revisado_por_id&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;INTEGER&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;&lt;b style=&quot;color:#006799;&quot;&gt;FK (usuarios.id)&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;Sí&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Clave foránea hacia el directivo o administrador en &amp;#x27;usuarios&amp;#x27; que aprobó o rechazó el reembolso.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;fecha_revision&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;TIMESTAMPTZ&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;Sí&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Fecha y hora exacta en que la administración resolvió la solicitud de reembolso.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;strokeColor=none;fillColor=none;overflow=fill;align=left;verticalAlign=top;spacing=0;" parent="1" vertex="1"><mxGeometry x="80" y="2796" width="1280" height="745" as="geometry" /></mxCell><mxCell id="dict_tbl_6_bonos_catalogo" value="&lt;table style=&quot;width:100%; border-collapse:collapse; font-family:Helvetica,Arial,sans-serif; background-color:#ffffff; border:2px solid #0c2b45;&quot;&gt;&lt;tr style=&quot;background-color:#0c2b45; color:#ffffff;&quot;&gt;&lt;td colspan=&quot;5&quot; style=&quot;padding:10px 14px; font-size:13px; font-weight:bold; border:1px solid #0c2b45; text-align:left;&quot;&gt;TABLA 6: bonos_catalogo (15 atributos) &amp;mdash; &lt;span style=&quot;font-weight:normal; color:#e2e8f0;&quot;&gt;Catálogo maestro de bonos sociales por contingencia y de calendario indexados al Sueldo Base Grado 15 (HU-05, HU-06).&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#006799; color:#ffffff; font-weight:bold; font-size:11.5px;&quot;&gt;&lt;td style=&quot;width:18%; padding:7px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Atributo&lt;/td&gt;&lt;td style=&quot;width:15%; padding:7px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Tipo de Dato&lt;/td&gt;&lt;td style=&quot;width:16%; padding:7px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;PK / FK&lt;/td&gt;&lt;td style=&quot;width:7%; padding:7px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;Nulo&lt;/td&gt;&lt;td style=&quot;width:44%; padding:7px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Descripci&amp;oacute;n&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;&lt;b&gt;&lt;u&gt;id&lt;/u&gt;&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;INTEGER&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;&lt;b style=&quot;color:#0c2b45;&quot;&gt;PK&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Identificador único autoincremental del bono en el catálogo oficial.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;codigo&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(60)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Clave única identificadora del beneficio (ej. vacaciones, escolaridad, nacimiento, invierno, navidad).&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;nombre&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(150)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Título institucional oficial del bono o beneficio social en el reglamento.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;porcentaje&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;FLOAT (FLOAT8)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Porcentaje reglamentario de cálculo sobre el Sueldo Base Imponible del Grado 15 Municipal.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;categoria&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(100)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Clasificación temática del beneficio (Descanso, Educación Familiar, Contingencia, Calendario, etc.).&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;requisitos&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;TEXT&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Condiciones estatutarias que debe acreditar el socio para acceder al beneficio.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;documentacion_requerida&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;TEXT&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Certificados o decretos exigidos como respaldo obligatorio para cursar el bono.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;regla_asignacion&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;TEXT&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Modalidad de otorgamiento (postulación del socio, asignación directa o nómina masiva).&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;periodo_devengo&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(100)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;Sí&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Época o mes del año en que se devenga el beneficio según el calendario del Comité.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;permite_postulacion_socio&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;BOOLEAN&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Define si el bono admite postulación directa desde el portal del socio (true) o solo nómina (false).&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;es_calendario&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;BOOLEAN&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Indica si corresponde a un bono periódico masivo de calendario (Invierno / Navidad).&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;activo&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;BOOLEAN&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Indica si el bono se encuentra vigente y habilitado en el catálogo actual del Comité.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;icono&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(50)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Identificador del ícono vectorial asociado a la tarjeta del beneficio en la interfaz web.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;created_at&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;TIMESTAMPTZ&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Fecha y hora exacta de creación del registro en la tabla &amp;#x27;bonos_catalogo&amp;#x27; (trazabilidad temporal).&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;updated_at&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;TIMESTAMPTZ&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Fecha y hora de la última actualización experimentada por el registro en &amp;#x27;bonos_catalogo&amp;#x27;.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;strokeColor=none;fillColor=none;overflow=fill;align=left;verticalAlign=top;spacing=0;" parent="1" vertex="1"><mxGeometry x="80" y="3586" width="1280" height="513" as="geometry" /></mxCell><mxCell id="dict_tbl_7_solicitudes_beneficio" value="&lt;table style=&quot;width:100%; border-collapse:collapse; font-family:Helvetica,Arial,sans-serif; background-color:#ffffff; border:2px solid #0c2b45;&quot;&gt;&lt;tr style=&quot;background-color:#0c2b45; color:#ffffff;&quot;&gt;&lt;td colspan=&quot;5&quot; style=&quot;padding:10px 14px; font-size:13px; font-weight:bold; border:1px solid #0c2b45; text-align:left;&quot;&gt;TABLA 7: solicitudes_beneficio (33 atributos) &amp;mdash; &lt;span style=&quot;font-weight:normal; color:#e2e8f0;&quot;&gt;Postulaciones individuales y liquidaciones de bonos sociales con snapshot financiero y datos de pago (HU-05).&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#006799; color:#ffffff; font-weight:bold; font-size:11.5px;&quot;&gt;&lt;td style=&quot;width:18%; padding:7px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Atributo&lt;/td&gt;&lt;td style=&quot;width:15%; padding:7px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Tipo de Dato&lt;/td&gt;&lt;td style=&quot;width:16%; padding:7px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;PK / FK&lt;/td&gt;&lt;td style=&quot;width:7%; padding:7px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;Nulo&lt;/td&gt;&lt;td style=&quot;width:44%; padding:7px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Descripci&amp;oacute;n&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;&lt;b&gt;&lt;u&gt;id&lt;/u&gt;&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;INTEGER&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;&lt;b style=&quot;color:#0c2b45;&quot;&gt;PK&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Identificador único autoincremental de la postulación o liquidación de bono social.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;&lt;b&gt;socio_id&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;INTEGER&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;&lt;b style=&quot;color:#006799;&quot;&gt;FK (usuarios.id)&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Clave foránea hacia el funcionario beneficiario en la tabla &amp;#x27;usuarios&amp;#x27;.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;tipo_bono&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(60)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Código identificador del bono solicitado (ej. vacaciones, escolaridad, nacimiento).&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;titulo_bono&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(120)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Snapshot con el nombre oficial del bono al momento de registrarse la postulación.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;porcentaje_base&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;FLOAT (FLOAT8)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Snapshot del porcentaje del Grado 15 aplicado para calcular el beneficio en esa fecha.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;sueldo_base_referencia&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;INTEGER&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Snapshot en CLP del Sueldo Base Grado 15 vigente al momento del cálculo (auditoría CGR).&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;monto_calculado&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;INTEGER&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Monto líquido resultante en pesos chilenos enteros (CLP) a pagar al socio beneficiario.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;estado&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(30)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Estado administrativo de la solicitud (&amp;#x27;PENDIENTE&amp;#x27;, &amp;#x27;APROBADO&amp;#x27;, &amp;#x27;RECHAZADO&amp;#x27;, &amp;#x27;LIQUIDADO&amp;#x27;).&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;motivo&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;TEXT&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;Sí&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Descripción del evento o contingencia invocada por el socio al postular al bono.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;documento_tipo&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(120)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Tipo de documento legal presentado como respaldo (Decreto Alcaldicio, Certificado Civil, FIBE).&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;documento_nombre&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(255)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;Sí&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Nombre del archivo digital adjunto que respalda el otorgamiento del beneficio.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;documento_url&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(500)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;Sí&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Ruta de almacenamiento interno del documento o decreto digitalizado.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;decreto_numero&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(100)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;Sí&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Número del Decreto Alcaldicio que autoriza el feriado legal o respalda el beneficio.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;decreto_fecha&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;DATE&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;Sí&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Fecha de emisión del Decreto Alcaldicio asociado a la solicitud.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;dias_habiles_feriado&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;INTEGER&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;Sí&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Cantidad de días hábiles continuos de feriado legal acreditados (mínimo 10 para Bono Vacaciones).&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;nombre_beneficiario&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(150)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;Sí&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Nombre del causante directo del bono (ej. hijo estudiante o recién nacido).&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;rut_beneficiario&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(20)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;Sí&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;RUN chileno del causante o carga asociada al bono de escolaridad o nacimiento.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;institucion_educacional&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(150)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;Sí&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Establecimiento educacional o universidad reconocida por el MINEDUC (Bono Escolaridad).&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;nivel_educacional&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(60)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;Sí&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Nivel cursado por el estudiante (Prebásica, Básica, Media o Superior).&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;edad_estudiante&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;INTEGER&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;Sí&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Edad del estudiante al postular (regla estatutaria: tope máximo de 24 años para Escolaridad).&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;asignacion_directa&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;BOOLEAN&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Indica si fue otorgado de oficio por administración/nómina (true) o por postulación del socio (false).&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;motivo_rechazo&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;TEXT&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;Sí&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Causal fundada en caso de que la Directiva rechace la postulación al bono.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;observaciones_admin&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;TEXT&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;Sí&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Anotaciones internas de revisión y liquidación registradas por Secretaría o Tesorería.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;&lt;b&gt;revisado_por_id&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;INTEGER&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;&lt;b style=&quot;color:#006799;&quot;&gt;FK (usuarios.id)&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;Sí&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Clave foránea hacia el directivo o administrador en &amp;#x27;usuarios&amp;#x27; que visó la solicitud.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;fecha_revision&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;TIMESTAMPTZ&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;Sí&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Fecha y hora exacta en que se efectuó la revisión administrativa del bono.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;metodo_pago&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(50)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;Sí&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Medio de pago empleado por Tesorería (&amp;#x27;Cheque&amp;#x27; o &amp;#x27;Transferencia&amp;#x27;).&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;numero_cheque&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(60)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;Sí&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Folio del cheque bancario o comprobante de transferencia emitido al socio.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;banco_emisor&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;VARCHAR(100)&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;Sí&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Entidad bancaria emisora del documento de pago (por defecto &amp;#x27;BancoEstado&amp;#x27;).&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;fecha_liquidacion&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;TIMESTAMPTZ&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;Sí&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Fecha y hora exacta en que Tesorería formalizó el pago o entrega del cheque.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;&lt;b&gt;liquidado_por_id&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;INTEGER&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;&lt;b style=&quot;color:#006799;&quot;&gt;FK (usuarios.id)&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;Sí&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Clave foránea hacia el Tesorero o Administrador en &amp;#x27;usuarios&amp;#x27; que ejecutó la liquidación.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;created_at&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;TIMESTAMPTZ&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Fecha y hora exacta de creación del registro en la tabla &amp;#x27;solicitudes_beneficio&amp;#x27; (trazabilidad temporal).&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;updated_at&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;TIMESTAMPTZ&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Fecha y hora de la última actualización experimentada por el registro en &amp;#x27;solicitudes_beneficio&amp;#x27;.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff; color:#1e293b; font-size:11px;&quot;&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace;&quot;&gt;&lt;b&gt;bono_id&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; font-family:Consolas,monospace; color:#334155;&quot;&gt;INTEGER&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center;&quot;&gt;&lt;b style=&quot;color:#006799;&quot;&gt;FK (bonos_catalogo.id)&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:center; font-weight:bold;&quot;&gt;Sí&lt;/td&gt;&lt;td style=&quot;padding:6px 10px; border:1px solid #cbd5e1; text-align:left;&quot;&gt;Clave foránea hacia la definición oficial del bono en la tabla &amp;#x27;bonos_catalogo&amp;#x27;.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;strokeColor=none;fillColor=none;overflow=fill;align=left;verticalAlign=top;spacing=0;" parent="1" vertex="1"><mxGeometry x="80" y="4144" width="1280" height="1035" as="geometry" /></mxCell><mxCell id="dict_tbl_8_nominas_masivas" value="&lt;table style=&quot;width:100%; border-collapse:collapse; font-family:Helvetica,Arial,sans-serif; background-color:#ffffff; border:2px solid #0c2b45;&quot;&gt;&lt;tr style=&quot;background-color:#0c2b45; color:#ffffff;&quot;&gt;&lt;td colspan=&quot;5&quot; style=&quot;padding:10px 14px; font-size:13px; font-weight:bold; border:1px solid #0c2b45; text-align:left;&quot;&gt;TABLA 8: nominas_masivas (18 atributos) &amp;mdash; &lt;span style=&quot;font-weight:normal; color:#e2e8f0;&quot;&gt;Cabecera de procesos de liquidación masiva de bonos periódicos de calendario para Tesorería Municipal (HU-06).&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#006799; color:#ffffff; font-weight:bold; font-siz