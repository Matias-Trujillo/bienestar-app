# ==============================================================================
# Variables de Entorno de Producción — Bienestar App Peralillo
# Copia este archivo a .env.production y ajusta las claves antes de iniciar:
# cp .env.production.example .env.production
# ==============================================================================

# Entorno general
ENVIRONMENT=production

# Base de Datos PostgreSQL
POSTGRES_USER=bienestar_admin
POSTGRES_PASSWORD=GeneraUnaClaveSeguraAqui2026!
POSTGRES_DB=bienestar_db_prod
POSTGRES_PORT=5432

# Seguridad JWT (Generar con: openssl rand -hex 32)
SECRET_KEY=94a50d2cf05d3b64bc63b84cbbe53f478e0db40245e4a87ad9685a19fb093b12

# Reglas Legales Ley N° 19.754
AFILIACION_VALIDAR_PERIODO=true
AFILIACION_PORCENTAJE_DESCUENTO=4
AFILIACION_MESES_CARENCIA=6

# Orígenes CORS permitidos (añadir el dominio final de Tailscale o DuckDNS)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
